{
  "manifest_version": 3,
  "name": "SecretIME — 入力モード補助",
  "version": "0.1.0",
  "description": "プライベート窓に連動してGoogle日本語入力の公式設定を補助します。学習停止の実効性は未検証です。",
  "minimum_chrome_version": "105",
  "incognito": "spanning",
  "permissions": ["nativeMessaging", "storage"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "SecretIME：学習停止は未検証"},
  "key": ""
}
